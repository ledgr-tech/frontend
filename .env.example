# Copie para .env.local (git-ignorado) e preencha. Nenhum valor real entra aqui.

# ---------------------------------------------------------------------------
# Backend (FastAPI no Railway)
# ---------------------------------------------------------------------------
# Sem NEXT_PUBLIC_ de proposito: o navegador nunca fala com o backend direto.
# Toda chamada passa por Server Actions (lib/backend.ts), que rodam no servidor
# e injetam o Bearer token. Expor a URL ao client nao traria nada e abriria
# caminho pra alguem tentar chamar o backend sem passar por elas.
LEDGR_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Autenticacao (NextAuth) — ADR-003 e 02-decisoes/05-contrato-jwt-empresa-id
# ---------------------------------------------------------------------------
# Segredo de assinatura do JWT (HS256). PRECISA ser byte a byte igual ao
# NEXTAUTH_SECRET do backend: e ele quem valida a assinatura do token que
# emitimos aqui. Divergiu, todo endpoint protegido responde 401.
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=

# So em producao/preview fora da Vercel. Local e na Vercel e detectado sozinho.
# NEXTAUTH_URL=https://app.ledgr.com.br

# ---------------------------------------------------------------------------
# Conta de teste — provisorio, sai quando o backend tiver login
# ---------------------------------------------------------------------------
# O backend ainda nao expoe endpoint de autenticacao (so /extratos e
# /conciliacoes), entao o login valida contra a conta de teste de
# lib/conta-teste.ts e pega o empresa_id daqui. Precisa ser o UUID de uma linha
# que existe mesmo na tabela empresas do banco apontado por LEDGR_API_URL — o
# backend confia no claim sem consultar nada, e o upload quebra em 404 se a
# empresa nao existir.
LEDGR_EMPRESA_ID_TESTE=
LEDGR_USUARIO_ID_TESTE=

# E-mail e senha da conta de teste. O repositorio e publico, entao a conta
# escrita no codigo so vale fora de producao (npm run dev). Em producao/preview
# (Vercel), sem estas duas ninguem entra — use uma senha nova, nunca a do codigo.
LEDGR_CONTA_TESTE_EMAIL=
LEDGR_CONTA_TESTE_SENHA=

# ---------------------------------------------------------------------------
# Atalhos de demonstracao — lib/demo.ts
# ---------------------------------------------------------------------------
# "1" liga o botao "Entrar com Google" e o fim do cadastro, que entram direto
# na conta de teste sem senha. Desligado (vazio), o botao some e o cadastro
# termina em "Cadastro ainda fechado". So ligue onde qualquer visitante puder
# ver os extratos da empresa de teste (local, ou a apresentacao do DemoDay).
# Vai pro bundle do navegador no build: mudar pede um deploy novo.
NEXT_PUBLIC_LEDGR_DEMO_ABERTA=
